NODE_ENV=development

DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full

CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_WEBHOOK_SIGNING_SECRET=

TRIGGER_SECRET_KEY=tr_dev_xxx
TRIGGER_PROJECT_REF=proj_xxx

OPENROUTER_API_KEY=sk-or-v1-xxx

MAGICA_API_KEY=gx_xxx
MAGICA_BASE_URL=https://inference.magica.com

FRONTEND_URL=http://localhost:3000

# Optional: uploads are the only feature these serve, and every Trigger.dev task parses this
# whole schema at boot. Absent, the sign route fails by name and nothing else is affected.
TRANSLOADIT_KEY=
TRANSLOADIT_SECRET=
# Hosts an upload result may be served from. Depends on where your Transloadit account stores
# results — leave empty to accept any address.
UPLOAD_RESULT_HOSTS=r2.dev,transloadit.com

ADMISSION_CREDITS=500000
SIGNUP_GRANT_CREDITS=30000000
OPENROUTER_DAILY_REQUESTS=50
MAX_TURNS=3
MAX_STEPS=4
MAX_SKILL_LOADS_PER_TURN=2
SEND_RATE_PER_MINUTE=10

DEMO_MODE=false
DISABLE_TITLE_GEN=false
